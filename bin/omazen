#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# See NOTICE for the required Omazen project attribution terms.

set -euo pipefail

OMAZEN_ENTRYPOINT=$(readlink -f -- "${BASH_SOURCE[0]}")
OMAZEN_ROOT=$(cd -- "$(dirname -- "$OMAZEN_ENTRYPOINT")/.." && pwd -P)
export OMAZEN_ROOT

# Resolve the packaged binary first and the source-build output second. This
# launcher contains no command implementation and fails closed if Rust is
# unavailable.
OMAZEN_RUST_CANDIDATE=${OMAZEN_RUST_BIN:-"$OMAZEN_ROOT/libexec/omazen-rust"}
if [[ ! -x $OMAZEN_RUST_CANDIDATE && -z ${OMAZEN_RUST_BIN:-} && \
      -x $OMAZEN_ROOT/target/release/omazen-rust ]]; then
  OMAZEN_RUST_CANDIDATE="$OMAZEN_ROOT/target/release/omazen-rust"
fi
[[ -x $OMAZEN_RUST_CANDIDATE ]] || {
  printf 'ERROR: Omazen Rust CLI is missing or not executable: %s\n' \
    "$OMAZEN_RUST_CANDIDATE" >&2
  exit 1
}

exec "$OMAZEN_RUST_CANDIDATE" "$@"
